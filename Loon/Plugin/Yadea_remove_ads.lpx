#!name=雅迪智行去广告
#!desc=保守清理雅迪智行 JSON 广告字段。若仍有广告，请先启用 Yadea_capture.lpx 抓脚本记录后补精准规则。
#!author=Codex
#!tag=去广告

[Rule]
DOMAIN, argo.yadeaiot.com.cn, REJECT

[Rewrite]
^https:\/\/gw\.yadeaiot\.com\.cn\/api\/app\/system\/operation-position\/v2\/pic-video-url\/list reject-dict
^https:\/\/gw\.yadeaiot\.com\.cn\/api\/app\/dLink\/batch\/get reject-dict
^https:\/\/gw\.yadeaiot\.com\.cn\/api\/app\/userappruleinfo\/queryuserappruleinfobyuserid reject-dict

[Script]
http-response ^https?:\/\/(?:[^\/]+\.)?(?:yadea\.com|yadea\.com\.cn|yadea\.net|yadeaapp\.com|yadeaiot\.com\.cn)\/ script-path=https://raw.githubusercontent.com/S7venYoung/NeTools/refs/heads/main/js/Yadea_remove_ads.js, requires-body=true, timeout=10, tag=雅迪智行去广告

[MitM]
hostname=*.yadea.com, *.yadea.com.cn, *.yadea.net, *.yadeaapp.com, *.yadeaiot.com.cn
